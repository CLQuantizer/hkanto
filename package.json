{
	"name": "hk",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.18.2",
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"build:tones": "node scripts/build-tones.mjs",
		"enrich:reading": "node scripts/enrich-reading.mjs",
		"build:reading-seed": "node scripts/build-reading-seed.mjs",
		"deploy": "pnpm build && cf build && cf deploy --prebuilt",
		"test:tones": "node --test scripts/test-tones.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.1.1",
		"@types/sanitize-html": "^2.16.1",
		"cf": "1.0.0-beta.26",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"wrangler": "^4.156.1"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^13.3.0",
		"@simplewebauthn/server": "^13.3.2",
		"marked": "^18.0.7",
		"sanitize-html": "^2.17.6",
		"to-jyutping": "^3.1.1",
		"zod": "^4.4.3"
	}
}
