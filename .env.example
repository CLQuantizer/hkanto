# Copy to `.dev.vars` for local Worker secrets (gitignored).

# Production: `pnpm exec wrangler secret put <NAME>` for secrets.

# Translation uses the Cloudflare Workers AI binding `AI` (no API key).
# Model is set in wrangler.jsonc as WORKERS_AI_MODEL.
# WORKERS_AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8

# --- Auth ---
# Signs passkey/password sessions and Gems admin sessions.
GEMS_SESSION_SECRET=replace-with-a-long-random-string

# Gems CMS admin password at /gems/admin (optional)
# GEMS_ADMIN_PASSWORD=